{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build -w apps/console",
  "outputDirectory": "apps/console/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{services/orchestrator/lanekeeper/**,fixtures/images/**}",
      "excludeFiles": "{**/__pycache__/**,**/tests/**}"
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self), microphone=()" }
    ] }
  ]
}
