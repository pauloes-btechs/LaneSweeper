{
  "name": "lanekeeper-os",
  "private": true,
  "version": "2.0.0-alpha.0",
  "description": "LaneKeeper OS: agent-orchestrated bike-lane hazard, fleet and rider-safety platform (simulation-first)",
  "type": "module",
  "workspaces": [
    "packages/*",
