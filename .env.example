# Copy to .env and fill in. Never commit .env.

# --- Database (local dev uses the Postgres started by `make db`) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lanekeeper

# --- Supabase (hosted project; leave blank to stay local) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# server-only, never shipped to a browser or device
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Google AI (server-only) ---
GOOGLE_API_KEY=
# live | offline. Defaults to live when GOOGLE_API_KEY is set.
AI_MODE=
# hard kill switch for every externally billable call
BILLABLE_CALLS_ENABLED=true
AI_DAILY_CALL_CAP=5000
AI_PER_MINUTE_CAP=60

# --- Orchestrator ---
LK_API_PORT=8787
# HMAC key for approval payload signatures and dev session tokens
LK_SIGNING_SECRET=change-me-dev-only
# real hardware gateway is not built; this must stay false
LK_HARDWARE_GATEWAY_ENABLED=false

# --- Device link (glasses/phone bridge) ---
LK_DEVICE_LINK_SECRET=change-me-dev-only

# --- Optional paid integrations (disabled; mock adapters used) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ROBOT_API_KEY=
